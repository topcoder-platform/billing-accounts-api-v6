{
  "name": "billing-accounts-api-v6",
  "version": "0.1.0",
  "private": true,
  "description": "Topcoder Billing Accounts & Clients API (NestJS + Prisma, CommonJS)",
  "main": "dist/main.js",
  "packageManager": "pnpm@11.15.1",
  "type": "commonjs",
  "scripts": {
    "build": "prisma generate && tsc --build tsconfig.json --force",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "import:legacy": "ts-node scripts/import-legacy.ts",
    "import:access": "ts-node scripts/import-ba-access.ts",
    "import:markup": "ts-node scripts/import-markup.ts",
    "backfill:clientIds": "ts-node scripts/backfill-client-ids.ts",
    "backfill:engagementPayments": "ts-node scripts/backfill-engagement-payments.ts",
    "verify:engagementPayments": "psql \"$DATABASE_URL\" -f scripts/verify-engagement-payment-backfill.sql",
    "generate:subcontractor-sql": "ts-node scripts/generate-subcontractor-sql.ts",
    "test:metadata": "node --test tests/salesforce-metadata.test.cjs",
    "test:sf-sync": "node --test tests/salesforce-sync.test.cjs",
    "test:dependency-compat": "node --test tools/minimatch-compat/index.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.3",
    "axios": "1.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "4.18.1",
    "pino": "^9.14.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "tc-core-library-js": "https://codeload.github.com/topcoder-platform/tc-core-library-js/tar.gz/2067e74f73d7fe3442c96f375fc97f8486f79be4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
